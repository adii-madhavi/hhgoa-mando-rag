# ---------------------------------------------------------------------------
# Credentials. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Sarvam: powers BOTH speech-to-text (saaras) and text-to-speech (bulbul).
# Without this the pipeline still runs, but the voice path is disabled and
# /health reports it.
SARVAM_API_KEY=

# Answer generation. Defaults to Sarvam's OpenAI-compatible endpoint; any
# OpenAI-compatible provider works by changing LLM_BASE_URL and LLM_MODEL.
# Without a key the pipeline falls back to the grounded extractive generator
# (no hallucination possible, but no Mando persona).
LLM_API_KEY=
LLM_BASE_URL=https://api.sarvam.ai/v1
# sarvam-m was deprecated 2026-08. The API offers sarvam-105b (a REASONING
# model) and sarvam-105b-conversations (non-reasoning).
#
# We default to -conversations on measured evidence (EXPERIMENTS.md E17):
# sarvam-105b spends 2,600-4,300 chars of reasoning_content before answering,
# costing 15.4 s P50 in English. -conversations emits ZERO reasoning tokens,
# runs at 4.3 s P50 (3.6x faster), and quality held -- grounded, correct
# language, valid citations.
LLM_MODEL=sarvam-105b-conversations

# Optional: raises Hugging Face rate limits during dataset/model download.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Retrieval configuration
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=e5-small
CHUNK_STRATEGY=fixed
RERANKER=mmr
TOP_K=5
CANDIDATE_K=50
# Measured to HURT on this dataset (see EXPERIMENTS.md E8). Off by default.
USE_BM25=false
USE_DENSE=true

# ---------------------------------------------------------------------------
# Guardrail thresholds. See EXPERIMENTS.md before changing these -- e5 cosine
# similarity does not span [-1,1]; unrelated text floors around 0.68, so any
# threshold below ~0.70 is a no-op.
# ---------------------------------------------------------------------------
GROUNDING_MIN_SEMANTIC=0.82
EVIDENCE_MIN_TOP=0.87
EVIDENCE_MIN_MEAN=0.85
ENFORCE_GROUNDING=true

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
PROCESSED_DIR=data/processed
INDEX_DIR=data/index
QDRANT_PATH=data/qdrant
